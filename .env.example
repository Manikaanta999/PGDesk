# PostgreSQL connection (DATABASE_URL takes precedence; legacy settings are for local development)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require"

# Legacy PostgreSQL runtime credentials
SQL_HOST="localhost"
SQL_DB_NAME="pgdesk"
SQL_USER="pgdesk_app"
SQL_PASSWORD="change_me"

# Legacy admin credentials (used by explicit Drizzle migrations when DATABASE_URL is unset)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="change_me"

# Session signing secret for credentials/demo cookie auth
SESSION_SECRET="replace-with-32-char-random-secret"

# Public URL of the deployed app (used in sitemap.xml, JSON-LD, and receipts)
APP_URL="http://localhost:3000"

# Set to "true" only in staging/sandbox environments to enable demo seeding & 1-click demo login
ENABLE_DEMO_MODE="false"

# Shared secret for automated daily billing cron (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="replace-with-32-char-cron-secret"

# Pluggable object storage provider: local_db | local | gcs | s3
STORAGE_PROVIDER="local_db"
UPLOAD_DIR="./uploads"

# GCS / S3 configuration (used when STORAGE_PROVIDER=gcs or s3)
GCS_BUCKET=""
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ==============================================================================
# Temporary Development / Testing Auth Policy (No External Email/SMS Provider)
# Keep restricted to dev/testing. Re-enable email verification & email password
# recovery ("true") after configuring Resend, SendGrid, or custom SMTP.
# ==============================================================================
AUTH_EMAIL_VERIFICATION_ENABLED="false"
AUTH_SMS_OTP_ENABLED="false"
AUTH_EMAIL_PASSWORD_RESET_ENABLED="false"

# Server-side ONLY secrets for administrator password reset (NEVER prefix with VITE_ or expose to client)
# ADMIN_RESET_SECRET=""
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
