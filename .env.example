# Cloud SQL (PostgreSQL) runtime credentials (injected automatically in AI Studio)
SQL_HOST="localhost"
SQL_DB_NAME="pgdesk"
SQL_USER="pgdesk_app"
SQL_PASSWORD="change_me"

# Cloud SQL Admin credentials (used by Drizzle Kit schema push/migrations)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="change_me"

# Session signing secret for credentials/demo cookie auth
SESSION_SECRET="replace-with-32-char-random-secret"

# Public URL of the deployed app (used in sitemap.xml, JSON-LD, and receipts)
APP_URL="http://localhost:3000"

# Set to "true" only in staging/sandbox environments to enable demo seeding & 1-click demo login
ENABLE_DEMO_MODE="false"

# Shared secret for automated daily billing cron (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="replace-with-32-char-cron-secret"

# Pluggable object storage provider: local_db | local | gcs | s3
STORAGE_PROVIDER="local_db"
UPLOAD_DIR="./uploads"

# GCS / S3 configuration (used when STORAGE_PROVIDER=gcs or s3)
GCS_BUCKET=""
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

